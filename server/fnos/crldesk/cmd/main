#!/bin/bash
# crldesk 生命周期脚本（fnOS 调用）
# 用法: main {start|stop|restart|status|log [N]}
# 退出码: 0=成功/运行中 3=未运行 1=失败

APP_NAME="${TRIM_APPNAME:-crldesk}"
PID_FILE="${TRIM_PKGVAR}/server.pid"
LOG_FILE="${TRIM_PKGVAR}/server.log"
PORT="${TRIM_SERVICE_PORT:-5555}"

# 定位 server.js：兼容 app/server 或 app 根目录两种布局
APP_DIR="${TRIM_APPDEST}"
SRV=""
if [ -f "$APP_DIR/server.js" ]; then
  SRV="$APP_DIR/server.js"
elif [ -f "$APP_DIR/app/server/server.js" ]; then
  SRV="$APP_DIR/app/server/server.js"
elif [ -f "$APP_DIR/server/server.js" ]; then
  SRV="$APP_DIR/server/server.js"
fi

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid=$(tr -d '[:space:]' < "$PID_FILE")
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "$APP_NAME is already running"
    exit 0
  fi
  mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
  if [ -z "$SRV" ] || [ ! -f "$SRV" ]; then
    echo "错误：未找到 server.js（检查 APP_DIR=$APP_DIR）" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    echo "错误：系统中未找到 node，无法启动 crldesk 服务" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  cd "$(dirname "$SRV")" || { echo "错误：无法进入应用目录" > "$TRIM_TEMP_LOGFILE"; exit 1; }
  export PORT="${PORT}"
  nohup node "$(basename "$SRV")" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1.5
  if is_running; then
    echo "$APP_NAME started (pid $(tr -d '[:space:]' < "$PID_FILE"))"
    exit 0
  fi
  echo "错误：$APP_NAME 启动失败，请查看日志 $LOG_FILE" > "$TRIM_TEMP_LOGFILE"
  tail -n 20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE" 2>/dev/null
  rm -f "$PID_FILE"
  exit 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(tr -d '[:space:]' < "$PID_FILE")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null
      local i=0
      while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do
        sleep 0.5
        i=$((i + 1))
      done
      kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$PID_FILE"
  fi
  echo "$APP_NAME stopped"
  exit 0
}

status() {
  if is_running; then
    echo "$APP_NAME is running"
    exit 0
  fi
  rm -f "$PID_FILE"
  echo "$APP_NAME is not running"
  exit 3
}

log() {
  if [ -f "$LOG_FILE" ]; then
    tail -n "${2:-100}" "$LOG_FILE"
  else
    echo "no log"
  fi
  exit 0
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  log) log ;;
  *) echo "usage: main {start|stop|restart|status|log [N]}"; exit 1 ;;
esac
